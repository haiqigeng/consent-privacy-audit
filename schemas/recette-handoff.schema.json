{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.codex/schemas/consent-privacy-audit/recette-handoff.schema.json",
  "title": "Supporting-only GTM recette handoff bundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_run_id", "generated_at", "handoffs"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "source_run_id": {"type": "string"},
    "generated_at": {"type": "string", "format": "date-time"},
    "handoffs": {"type": "array", "items": {"$ref": "#/$defs/handoff"}}
  },
  "$defs": {
    "handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["handoff_id", "source_finding_fingerprint", "source_evidence_ids", "suspected_gtm_container", "reproduction", "expected_behaviour", "observed_behaviour", "consent_state", "vendor_product_key", "request_cues", "acceptance_rule", "limitations", "role", "verdict_authority"],
      "properties": {
        "handoff_id": {"type": "string"},
        "source_finding_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "source_evidence_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "suspected_gtm_container": {"type": ["string", "null"]},
        "reproduction": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "expected_behaviour": {"type": "string"},
        "observed_behaviour": {"type": "string"},
        "consent_state": {"type": "string"},
        "vendor_product_key": {"type": "string"},
        "request_cues": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "acceptance_rule": {"type": "string"},
        "limitations": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "role": {"const": "SUPPORTING_ONLY"},
        "verdict_authority": {"const": false}
      }
    }
  }
}
