{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.codex/schemas/consent-privacy-audit/remediation-handoff.schema.json",
  "title": "Manual-only remediation handoff bundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_run_id", "generated_at", "handoffs"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "source_run_id": {"type": "string"},
    "generated_at": {"type": "string", "format": "date-time"},
    "handoffs": {"type": "array", "items": {"$ref": "#/$defs/handoff"}}
  },
  "$defs": {
    "handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["handoff_id", "source_finding_fingerprint", "primary_owner", "contributing_owners", "cause_status", "requested_outcome", "prohibited_reinterpretations", "approval_state", "external_decisions", "retest_rule", "role"],
      "properties": {
        "handoff_id": {"type": "string"},
        "source_finding_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "primary_owner": {"type": "string"},
        "contributing_owners": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "cause_status": {"enum": ["CONFIRMED", "SUSPECTED", "UNKNOWN", "NOT_APPLICABLE"]},
        "requested_outcome": {"type": "string"},
        "prohibited_reinterpretations": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "approval_state": {"enum": ["PROPOSED", "APPROVED", "REJECTED"]},
        "external_decisions": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "retest_rule": {"type": "string"},
        "role": {"const": "MANUAL_ONLY"}
      }
    }
  }
}
