{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.codex/schemas/consent-privacy-audit/audit-run.schema.json",
  "title": "Consent runtime audit run",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "skill_version",
    "status",
    "created_at",
    "site",
    "scope",
    "browser",
    "network_route",
    "rule_profiles",
    "source_checks",
    "cmp",
    "scenarios",
    "capture_capabilities",
    "evidence_policy",
    "technical_priority_rubric_version",
    "finding_fingerprint_algo_version",
    "identity_normalization_version",
    "vendor_signature_registry_version",
    "scenario_contract_version",
    "outputs",
    "overall_technical_outcome"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "run_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"},
    "skill_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "status": {"enum": ["PLANNED", "RUNNING", "COMPLETE", "ABORTED"]},
    "created_at": {"type": "string", "format": "date-time"},
    "started_at": {"type": ["string", "null"], "format": "date-time"},
    "completed_at": {"type": ["string", "null"], "format": "date-time"},
    "abort_reason": {"type": ["string", "null"], "maxLength": 2000},
    "site": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin", "environment", "deployment_verified", "deployment_evidence"],
      "properties": {
        "origin": {"type": "string", "format": "uri"},
        "environment": {"enum": ["production", "staging", "preproduction", "test", "unknown"]},
        "deployment_verified": {"type": "boolean"},
        "deployment_evidence": {"type": "array", "items": {"type": "string", "maxLength": 1000}, "uniqueItems": true}
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["urls", "markets", "declaration_urls", "exclusions", "authenticated_boundaries"],
      "properties": {
        "urls": {"type": "array", "minItems": 1, "items": {"type": "string", "format": "uri"}, "uniqueItems": true},
        "markets": {"type": "array", "items": {"type": "string", "minLength": 2}, "uniqueItems": true},
        "declaration_urls": {"type": "array", "items": {"type": "string", "format": "uri"}, "uniqueItems": true},
        "exclusions": {"type": "array", "items": {"type": "string", "maxLength": 1000}, "uniqueItems": true},
        "authenticated_boundaries": {"type": "array", "items": {"type": "string", "maxLength": 1000}, "uniqueItems": true}
      }
    },
    "browser": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engine", "version", "headed", "viewport", "locale", "timezone", "user_agent", "cache_policy", "service_worker_policy", "extensions"],
      "properties": {
        "engine": {"const": "chromium"},
        "version": {"type": "string", "minLength": 1},
        "headed": {"type": "boolean"},
        "viewport": {
          "type": "object",
          "additionalProperties": false,
          "required": ["width", "height", "device_scale_factor"],
          "properties": {
            "width": {"type": "integer", "minimum": 320, "maximum": 10000},
            "height": {"type": "integer", "minimum": 240, "maximum": 10000},
            "device_scale_factor": {"type": "number", "exclusiveMinimum": 0, "maximum": 10}
          }
        },
        "locale": {"type": "string", "minLength": 2},
        "timezone": {"type": "string", "minLength": 1},
        "user_agent": {"type": "string", "minLength": 1},
        "cache_policy": {"enum": ["fresh_context", "persistence_context"]},
        "service_worker_policy": {"enum": ["allow_and_capture", "block", "unknown"]},
        "extensions": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "network_route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["route_id", "proxy", "externally_verified_region", "browser_geolocation_emulated"],
      "properties": {
        "route_id": {"type": "string", "minLength": 1},
        "proxy": {"type": ["string", "null"]},
        "externally_verified_region": {"type": ["string", "null"]},
        "browser_geolocation_emulated": {"type": "boolean"}
      }
    },
    "rule_profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["profile_id", "version", "applicability"],
        "properties": {
          "profile_id": {"type": "string"},
          "version": {"type": "string"},
          "applicability": {"enum": ["CONFIRMED", "CLIENT_ASSERTED", "REQUIRES_DPO_CONFIRMATION", "NOT_APPLICABLE", "UNKNOWN"]}
        }
      }
    },
    "source_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "status", "checked_at", "dependent_rule_ids", "task_required"],
        "properties": {
          "source_id": {"type": "string"},
          "status": {"enum": ["MATCHED", "CHANGED", "UNREACHABLE", "STALE", "NOT_CHECKED"]},
          "checked_at": {"type": ["string", "null"], "format": "date-time"},
          "dependent_rule_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "task_required": {"type": "boolean"},
          "note": {"type": ["string", "null"], "maxLength": 1000}
        }
      }
    },
    "cmp": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter_id", "adapter_version", "provider", "detection_confidence", "interaction_method", "limitations"],
      "properties": {
        "adapter_id": {"type": ["string", "null"]},
        "adapter_version": {"type": ["string", "null"]},
        "provider": {"type": ["string", "null"]},
        "detection_confidence": {"enum": ["CONFIRMED", "PROBABLE", "UNKNOWN", "CONFLICTING"]},
        "interaction_method": {"enum": ["UI", "ANALYST_ASSISTED", "API_FALLBACK", "NONE"]},
        "limitations": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scenario_id", "scenario_class", "status", "context_id", "pages", "actions", "state_verified", "capture_status", "limitations"],
        "properties": {
          "scenario_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
          "scenario_class": {"enum": ["UNTOUCHED", "REJECTED", "ACCEPTED", "ACCEPTED_TO_WITHDRAWN", "PERSISTENCE_ACCEPTED", "PERSISTENCE_REJECTED", "GRANULAR_DENIED", "REJECTED_TO_ACCEPTED"]},
          "status": {"enum": ["REGISTERED", "RUNNING", "COMPLETE", "INCONCLUSIVE", "NOT_TESTED", "ABORTED"]},
          "context_id": {"type": ["string", "null"]},
          "pages": {"type": "array", "items": {"type": "string", "format": "uri"}, "uniqueItems": true},
          "actions": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "state_verified": {"type": ["boolean", "null"]},
          "capture_status": {
            "type": "object",
            "additionalProperties": false,
            "required": ["network", "cookies", "storage", "cmp_state", "scripts_embeds", "screenshot", "attribution", "service_workers"],
            "properties": {
              "network": {"enum": ["REGISTERED", "COMPLETE", "INCONCLUSIVE", "NOT_TESTED", "ABORTED"]},
              "cookies": {"enum": ["REGISTERED", "COMPLETE", "INCONCLUSIVE", "NOT_TESTED", "ABORTED"]},
              "storage": {"enum": ["REGISTERED", "COMPLETE", "INCONCLUSIVE", "NOT_TESTED", "ABORTED"]},
              "cmp_state": {"enum": ["REGISTERED", "COMPLETE", "INCONCLUSIVE", "NOT_TESTED", "ABORTED"]},
              "scripts_embeds": {"enum": ["REGISTERED", "COMPLETE", "INCONCLUSIVE", "NOT_TESTED", "ABORTED"]},
              "screenshot": {"enum": ["REGISTERED", "COMPLETE", "INCONCLUSIVE", "NOT_TESTED", "ABORTED"]},
              "attribution": {"enum": ["REGISTERED", "COMPLETE", "INCONCLUSIVE", "NOT_TESTED", "ABORTED"]},
              "service_workers": {"enum": ["REGISTERED", "COMPLETE", "INCONCLUSIVE", "NOT_TESTED", "ABORTED"]}
            }
          },
          "limitations": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
        }
      }
    },
    "capture_capabilities": {
      "type": "object",
      "additionalProperties": {"type": "boolean"},
      "required": ["network", "cookies", "storage", "cmp_state", "scripts_embeds", "service_workers", "screenshots", "initiators"]
    },
    "evidence_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["raw_har_delivered", "request_bodies_retained", "cookie_values_retained", "canary_values_retained", "restricted_evidence_authorized"],
      "properties": {
        "raw_har_delivered": {"const": false},
        "request_bodies_retained": {"const": false},
        "cookie_values_retained": {"const": false},
        "canary_values_retained": {"const": false},
        "restricted_evidence_authorized": {"type": "boolean"}
      }
    },
    "technical_priority_rubric_version": {"type": "string", "pattern": "^technical-priority-v[0-9]+$"},
    "finding_fingerprint_algo_version": {"type": "string", "pattern": "^finding-fingerprint-[a-z0-9-]+-v[0-9]+$"},
    "identity_normalization_version": {"type": "string", "pattern": "^[a-z0-9-]+-v[0-9]+$"},
    "vendor_signature_registry_version": {"type": "string", "minLength": 1},
    "scenario_contract_version": {"type": "string", "pattern": "^consent-scenarios-v[0-9]+$"},
    "outputs": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": {"type": "string"},
          "sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"}
        }
      }
    },
    "overall_technical_outcome": {"type": ["string", "null"], "enum": ["NO_SAMPLED_CONTRADICTION", "CONTRADICTIONS_OBSERVED", "MATERIAL_TESTS_INCONCLUSIVE", null]}
  }
}
