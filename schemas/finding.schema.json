{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.codex/schemas/consent-privacy-audit/finding.schema.json",
  "title": "Consent runtime technical finding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "finding_fingerprint", "finding_fingerprint_algo_version",
    "fingerprint_inputs", "finding_kind", "rule_id", "title", "observed_fact",
    "expected_technical_behaviour", "technical_test_status", "technical_priority",
    "technical_priority_rubric_version", "technical_priority_inputs",
    "rule_applicability", "rule_source_ids", "rule_authority", "fact_class",
    "scenario_classes", "action_windows", "locations", "test_context", "evidence_ids", "observed_initiator",
    "attribution_confidence", "suspected_implementation_layer", "root_cause_status",
    "confirmed_root_cause_evidence", "primary_owner", "contributing_owners",
    "dependencies", "proposed_outcome", "retest_steps", "legal_review_required",
    "limitations", "first_seen", "last_seen"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "finding_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "finding_fingerprint_algo_version": {"type": "string", "pattern": "^finding-fingerprint-[a-z0-9-]+-v[0-9]+$"},
    "fingerprint_inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_id", "finding_kind", "vendor_product_key", "scenario_class", "location_pattern"],
      "properties": {
        "rule_id": {"type": "string"},
        "finding_kind": {"type": "string"},
        "vendor_product_key": {"type": "string"},
        "scenario_class": {"type": "string"},
        "location_pattern": {"type": "string"}
      }
    },
    "finding_kind": {"enum": ["SENSITIVE_DATA_DISCLOSURE", "CONSENT_STATE_CONTRADICTION", "CHOICE_OR_WITHDRAWAL_FAILURE", "PERSISTENCE_FAILURE", "DECLARATION_MISMATCH", "STATE_VERIFICATION_GAP", "EXPECTED_OBSERVATION", "OTHER"]},
    "rule_id": {"type": "string"},
    "title": {"type": "string", "minLength": 3, "maxLength": 300},
    "observed_fact": {"type": "string", "minLength": 3, "maxLength": 4000},
    "expected_technical_behaviour": {"type": "string", "minLength": 3, "maxLength": 4000},
    "technical_test_status": {"enum": ["EXPECTED_BEHAVIOUR_OBSERVED", "UNEXPECTED_BEHAVIOUR_OBSERVED", "INCONCLUSIVE", "NOT_APPLICABLE", "NOT_TESTED"]},
    "technical_priority": {"enum": ["URGENT", "HIGH", "MEDIUM", "LOW", "INFORMATIONAL"]},
    "technical_priority_rubric_version": {"type": "string", "pattern": "^technical-priority-v[0-9]+$"},
    "technical_priority_inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sensitive_category", "unintended_collection", "reproduced", "direct_identifier_canary", "consent_state_contradiction", "scenario_class", "purpose_candidate", "stable_identifier", "systemic", "choice_withdrawal_persistence_failure", "unresolved_proxy_worker", "observed_undeclared", "required_state_inconclusive", "localized_defect", "optional_inconclusive", "expected", "not_applicable", "deliberately_not_tested", "declared_unobserved"],
      "properties": {
        "sensitive_category": {"enum": ["NONE", "DIRECT_IDENTIFIER", "CREDENTIAL", "AUTH_TOKEN", "PAYMENT", "SPECIAL_CATEGORY", "OTHER"]},
        "unintended_collection": {"type": "boolean"},
        "reproduced": {"type": "boolean"},
        "direct_identifier_canary": {"type": "boolean"},
        "consent_state_contradiction": {"type": "boolean"},
        "scenario_class": {"enum": ["UNTOUCHED", "REJECTED", "ACCEPTED", "ACCEPTED_TO_WITHDRAWN", "PERSISTENCE_ACCEPTED", "PERSISTENCE_REJECTED", "GRANULAR_DENIED", "REJECTED_TO_ACCEPTED"]},
        "purpose_candidate": {"enum": ["ADVERTISING", "PERSONALIZATION", "ANALYTICS", "FUNCTIONAL", "SECURITY", "CMP", "TAG_MANAGER", "UNKNOWN"]},
        "stable_identifier": {"type": "boolean"},
        "systemic": {"type": "boolean"},
        "choice_withdrawal_persistence_failure": {"type": "boolean"},
        "unresolved_proxy_worker": {"type": "boolean"},
        "observed_undeclared": {"type": "boolean"},
        "required_state_inconclusive": {"type": "boolean"},
        "localized_defect": {"type": "boolean"},
        "optional_inconclusive": {"type": "boolean"},
        "expected": {"type": "boolean"},
        "not_applicable": {"type": "boolean"},
        "deliberately_not_tested": {"type": "boolean"},
        "declared_unobserved": {"type": "boolean"}
      }
    },
    "rule_applicability": {"enum": ["CONFIRMED", "CLIENT_ASSERTED", "REQUIRES_DPO_CONFIRMATION", "NOT_APPLICABLE", "UNKNOWN"]},
    "rule_source_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "rule_authority": {"type": "string", "minLength": 1},
    "fact_class": {"enum": ["BROWSER_OBSERVED", "ADMIN_EVIDENCED", "CLIENT_ASSERTED", "UNOBSERVABLE"]},
    "scenario_classes": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "action_windows": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "locations": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "test_context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["browser_engine", "browser_version", "network_route_id", "verified_region", "market_claim_supported"],
      "properties": {
        "browser_engine": {"const": "chromium"},
        "browser_version": {"type": "string"},
        "network_route_id": {"type": "string"},
        "verified_region": {"type": ["string", "null"]},
        "market_claim_supported": {"type": "boolean"}
      }
    },
    "evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^EVD-"}, "uniqueItems": true},
    "observed_initiator": {"type": ["string", "null"], "maxLength": 1000},
    "attribution_confidence": {"enum": ["CONFIRMED", "PROBABLE", "UNKNOWN", "CONFLICTING"]},
    "suspected_implementation_layer": {"enum": ["GTM_CONTAINER", "OTHER_TAG_MANAGER", "HARDCODED_OR_BUNDLED", "CMS_THEME_PLUGIN", "EMBED_OR_IFRAME", "CMP", "SERVICE_WORKER", "FIRST_PARTY_PROXY_OR_GATEWAY", "POLICY_OR_ORGANIZATIONAL", "UNKNOWN"]},
    "root_cause_status": {"enum": ["CONFIRMED", "SUSPECTED", "UNKNOWN", "NOT_APPLICABLE"]},
    "confirmed_root_cause_evidence": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "primary_owner": {"enum": ["GTM_OWNER", "DEVELOPER", "CMS_OWNER", "CMP_ADMIN", "DPO_LEGAL", "SERVER_SIDE_OWNER", "VENDOR_OWNER", "ANALYST_INVESTIGATION"]},
    "contributing_owners": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "dependencies": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "proposed_outcome": {"type": "string", "minLength": 3, "maxLength": 4000},
    "retest_steps": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "legal_review_required": {"type": "boolean"},
    "limitations": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "first_seen": {"type": "string", "format": "date-time"},
    "last_seen": {"type": "string", "format": "date-time"}
  }
}
