{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.codex/schemas/consent-privacy-audit/interaction-plan.schema.json",
  "title": "Safe synthetic interaction plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "environment", "actions", "submission_authorizations"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "environment": {"enum": ["production", "staging", "preproduction", "test"]},
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["action_id", "scenario_classes", "url", "kind", "locator", "canary_id", "effect", "authorization_id"],
        "properties": {
          "action_id": {"type": "string"},
          "scenario_classes": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
          "url": {"type": "string", "format": "uri"},
          "kind": {"enum": ["FILL", "BLUR", "VALIDATE", "STEP_ADVANCE", "SUBMIT"]},
          "locator": {
            "type": "object",
            "additionalProperties": false,
            "required": ["by", "value"],
            "properties": {
              "by": {"enum": ["LABEL", "ROLE_NAME", "CSS"]},
              "value": {"type": "string", "minLength": 1}
            }
          },
          "canary_id": {"type": ["string", "null"]},
          "effect": {"enum": ["FIELD_ONLY", "NON_SUBMITTING_STEP", "FORM_SUBMISSION"]},
          "authorization_id": {"type": ["string", "null"]}
        }
      }
    },
    "submission_authorizations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["authorization_id", "environment", "exact_origin", "form_identity", "allowed_synthetic_record", "scan_window", "notification_risk", "cleanup_owner", "cleanup_method", "authorized_by", "authorized_at"],
        "properties": {
          "authorization_id": {"type": "string"},
          "environment": {"enum": ["production", "staging", "preproduction", "test"]},
          "exact_origin": {"type": "string", "format": "uri"},
          "form_identity": {"type": "string"},
          "allowed_synthetic_record": {"type": "string"},
          "scan_window": {"type": "string"},
          "notification_risk": {"type": "string"},
          "cleanup_owner": {"type": "string"},
          "cleanup_method": {"type": "string"},
          "authorized_by": {"type": "string"},
          "authorized_at": {"type": "string", "format": "date-time"}
        }
      }
    }
  }
}
